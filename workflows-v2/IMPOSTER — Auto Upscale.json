    {
      "parameters": {
        "jsCode": "// One command processed every image of the order; stdout has one JSON line per image, in order.\nconst jobs = $('Build Jobs').all();\nconst lines = String($json.stdout || '').split('\\n').map(l => l.trim()).filter(l => l.startsWith('{'));\nreturn jobs.map((j, i) => {\n  let r = { status: 'ERROR', note: 'no output from upscale script' };\n  try { if (lines[i]) r = JSON.parse(lines[i]); } catch (e) { r.note = 'bad script output'; }\n  return { json: { ...j.json, result: r } };\n});"
      },
      "id": "509525ad-cea1-49d7-a80c-34dae289e0d3",
      "name": "Parse Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
