    {
      "parameters": {
        "jsCode": "// Runs once for the whole order after every image has been processed.\nconst parsed = $('Parse Result').all();\nconst uploads = $('Upload To FINAL').all();\nconst orderId = parsed.length ? parsed[0].json.order_id : '';\nlet ok = 0, skipped = 0;\nconst problems = [], warnings = [];\n\nparsed.forEach((p, i) => {\n  const j = p.json, r = j.result || {};\n  const uploaded = uploads[i] && uploads[i].json && uploads[i].json.id && !uploads[i].json.error;\n  const tag = `${j.size} ${j.label}`;\n  if (r.status === 'ERROR' || !uploaded) {\n    problems.push(`${tag}: ${r.status === 'ERROR' ? r.note : 'upload to FINAL failed'}`);\n    return;\n  }\n  if (r.status === 'SKIPPED') skipped++; else ok++;\n  if (String(r.note || '').includes('ASPECT_OFF')) warnings.push(`${tag}: aspect ratio is not A-size, check crop`);\n});\n\nconst total = parsed.length;\nconst failed = problems.length;\nconst status = failed ? 'UPSCALE ISSUE' : 'AWAITING REVIEW';\nconst hq = parsed.length && parsed[0].json.mode === 'max';\nlet notes = `${hq ? 'HQ ' : ''}Auto-upscale: ${ok} upscaled, ${skipped} already print-res, ${failed} failed (of ${total}).`;\nif (warnings.length) notes += ' WARN: ' + warnings.join(' | ');\nif (failed) notes += ' FAILED: ' + problems.join(' | ');\nreturn [{ json: { order_id: orderId, design_status: status, notes } }];",
        "mode": "runOnceForAllItems"
      },
      "id": "32c1a36b-24c5-4b53-ba41-cc94172ba708",
      "name": "Summarize Order",
