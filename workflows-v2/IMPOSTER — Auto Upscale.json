    {
      "parameters": {
        "jsCode": "// One item per image to upscale.\nconst body = $json.body || $json;\nconst jobs = body.queue_only ? [] : (body.jobs || []);\nreturn jobs.map((j, i) => ({\n  json: {\n    ...j,\n    mode: j.mode || body.mode || 'normal',\n    order_id: body.order_id,\n    customer_name: body.customer_name,\n    job_id: `${body.order_id}_${j.size}_${j.label}`,\n    out_name: `${body.order_id}_${j.size}_${j.label}.png`,\n    target_folder_id: body.final_folders[j.size],\n    in_path: `/Users/aryanjain/.n8n-files/imposter/work/${body.order_id}_${j.size}_${j.label}.src`,\n    out_path: `/Users/aryanjain/.n8n-files/imposter/work/${body.order_id}_${j.size}_${j.label}.png`\n  }\n}));"
      },
