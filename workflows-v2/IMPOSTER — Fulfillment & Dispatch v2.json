    {
      "parameters": {
        "jsCode": "const order = $('Google Sheets Trigger').first().json;\nconst folderId = $('Find FINAL Folder').first().json.id;\nconst folderLink = 'https://drive.google.com/drive/folders/' + folderId;\n\n// Pricing (effective 6 Oct 2026)\n// A3 (297 x 420 mm): 1 poster Rs 60 | 5 posters Rs 250\n// A4 (210 x 297 mm): 1 poster Rs 40 | 5 posters Rs 170\nfunction priceFor(qty, single, packQty, packPrice) {\n  qty = Number(qty) || 0;\n  if (qty <= 0) return 0;\n  return Math.floor(qty / packQty) * packPrice + (qty % packQty) * single;\n}\nconst a3Qty = Number(order['A3 Quantity']) || 0;\nconst a4Qty = Number(order['A4 Quantity']) || 0;\nconst a3Price = priceFor(a3Qty, 60, 5, 250);\nconst a4Price = priceFor(a4Qty, 40, 5, 170);\nconst totalPrice = a3Price + a4Price;\n\nconst lines = [];\nif (a3Qty > 0) lines.push('A3 x ' + a3Qty + ' = ₹' + a3Price);\nif (a4Qty > 0) lines.push('A4 x ' + a4Qty + ' = ₹' + a4Price);\nconst breakdown = lines.join('\\n');\n\nconst name = order['Customer Name'];\nconst folderText = 'Please check this folder link to verify your chosen designs, ensure there are no errors, and see the exact high quality you will get in the final print: ' + folderLink;\nconst orderText = 'Your order:\\n' + breakdown + '\\nTotal: ₹' + totalPrice;\nconst reviewText = 'Please check your designs in the folder above. If everything is correct and the quality looks good, just reply *Everything fine* and we will start printing. If you want to put a higher quality image, reply here with your new file and we will replace it before printing.';\n\nlet message = '';\nif (order['Payment Mode'] === 'Cash') {\n  message = 'Hi ' + name + '! Your IMPOSTER order is ready for print.\\n\\n' + folderText + '\\n\\n' + orderText + '\\n\\n' + reviewText + '\\n\\nSince you chose Cash, please note that we collect payment in advance before printing.';\n} else {\n  message = 'Hi ' + name + '! Your IMPOSTER order is received and we are verifying your payment screenshot.\\n\\n' + folderText + '\\n\\n' + orderText + '\\n\\n' + reviewText + '\\n\\nWe will process your print and deliver it to your hostel soon!';\n}\n\nlet phone = order['WhatsApp'].toString().replace(/\\D/g, '');\nif (phone.length === 10) {\n  phone = '91' + phone;\n}\nconst waLink = 'https://wa.me/' + phone + '?text=' + encodeURIComponent(message);\n\nreturn [{\n  json: {\n    whatsapp_message: message,\n    whatsapp_link: waLink,\n    zip_link: folderLink,\n    a3_price: a3Price,\n    a4_price: a4Price,\n    total_price: totalPrice\n  }\n}];"
      },
