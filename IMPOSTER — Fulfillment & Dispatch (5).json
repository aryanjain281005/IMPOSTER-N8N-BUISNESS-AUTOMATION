    {
      "parameters": {
        "jsCode": "// 1. Get the order data and the FINAL folder ID\nconst order = $('Google Sheets Trigger').first().json;\nconst folderId = $('Find FINAL Folder').first().json.id;\n\n// 2. Construct the direct link to the Drive folder\nconst folderLink = `https://drive.google.com/drive/folders/${folderId}`;\n\nlet message = \"\";\n\n// 3. Check the payment mode and write the dynamic message\nif (order[\"Payment Mode\"] === \"Cash\") {\n    message = `Hi ${order[\"Customer Name\"]}! Your IMPOSTER order is ready for print.\\n\\nPlease check this folder link to verify your chosen designs, ensure there are no errors, and see the exact high quality you will get in the final print: ${folderLink}\\n\\nYour total is ₹${order[\"Total Price\"]}. Since you chose Cash, please note that we collect payment in advance before printing.`;\n} else {\n    message = `Hi ${order[\"Customer Name\"]}! Your IMPOSTER order is received and we are verifying your payment screenshot.\\n\\nPlease check this folder link to verify your chosen designs, ensure there are no errors, and see the exact high quality you will get in the final print: ${folderLink}\\n\\nYour total is ₹${order[\"Total Price\"]}. We will process your print and deliver it to your hostel soon!`;\n}\n\n// 4. Format the WhatsApp number\nlet phone = order[\"WhatsApp\"].toString().replace(/\\D/g, '');\nif (phone.length === 10) {\n    phone = \"91\" + phone;\n}\n\n// 5. Create the final clickable URL\nconst waLink = `https://wa.me/${phone}?text=${encodeURIComponent(message)}`;\n\n// 6. Output the data\nreturn [{\n    json: {\n        whatsapp_message: message,\n        whatsapp_link: waLink,\n        zip_link: folderLink // Kept as zip_link so your Sheets node doesn't break\n    }\n}];\n"
      },
